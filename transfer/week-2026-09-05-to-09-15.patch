+
+      <div style={{ font: `700 8px ${mono}`, color: GOLD, letterSpacing: '0.16em', margin: '2px 2px 7px' }}>
+        YOUR RUNS · {runs.length}
+      </div>
+
+      {runs.map(run => {
+        const open = openId === run.id;
