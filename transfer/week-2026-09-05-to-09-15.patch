+
+/** End the session's window immediately, hand-off grace or not. */
+export function endMiniPlayer() {
+  clearTimeout(idleTimer);
+  idleTimer = null;
+  currentSource = null;
+  shared?.destroy();
+  shared = null;
+  unwatchForExit();
+}
